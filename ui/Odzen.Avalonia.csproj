<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\odzen_logo.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <GarbageCollectionAdaptationMode>1</GarbageCollectionAdaptationMode>
    <DebugSymbols>false</DebugSymbols>
    <DebugType>none</DebugType>

    <!-- Project & Author Identity -->
    <AssemblyName>ODZEN</AssemblyName>
    <RootNamespace>Odzen.Avalonia</RootNamespace>
    <Authors>Taroxzen</Authors>
    <Company>Taroxzen</Company>
    <Product>ODZEN</Product>
    <Copyright>Copyright © 2026 Taroxzen (https://github.com/taroxzen)</Copyright>
    <PackageProjectUrl>https://github.com/taroxzen</PackageProjectUrl>
    <RepositoryUrl>https://github.com/taroxzen/ODZEN</RepositoryUrl>
    <Version>1.3.0</Version>
    <AssemblyVersion>1.3.0.0</AssemblyVersion>
    <FileVersion>1.3.0.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.3" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.3" />
    <PackageReference Include="Avalonia.Svg.Skia" Version="11.2.0.2" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="System.Drawing.Common" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\core\odzen-core.exe" Condition="Exists('..\core\odzen-core.exe')" Link="odzen-core.exe" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
